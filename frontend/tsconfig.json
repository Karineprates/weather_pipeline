{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],

    "skipLibCheck": true,
    "strict": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,

    "jsx": "react-jsx",

    "baseUrl": "./src",
    "paths": {
      "@/*": ["*"]
    },

    "noEmit": true
  },
  "include": [
    "src",
    "src/vite-env.d.ts"
  ]
}
